{
   "action": {
      "default_title": "Home - New Tab Page"
   },
   "background": {
      "scripts": [
         "js/browser_compat.js",
         "js/background/offscreen_setup_bg.js",
         "js/default_service_worker.js",
         "js/background/default_bg.js",
         "js/logerror.js",
         "js/lib/promise.js",
         "js/background/wallpaper.js",
         "js/lib/filesystem.js",
         "js/search/common.js",
         "js/search/words_index.js",
         "js/search/background.js",
         "js/weather/weather_conditions.js",
         "js/weather/weather_background.js",
         "3rd-party/closed-tab/bg.js",
         "3rd-party/gmail/gmail.js",
         "3rd-party/gcalendar/gcalendar.js",
         "js/service_worker.js"
      ]
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "homenewtab@local.test",
         "strict_min_version": "109.0"
      }
   },
   "chrome_url_overrides": {
      "newtab": "index.html"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "js/content_script.js" ],
      "matches": [ "http://www.homenewtab.com/*", "https://www.homenewtab.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "js/search/search_content_script.js" ],
      "matches": [ "*://*.homenewtabsearch.com/*", "*://homenewtabsearch.com.s3-website-us-east-1.amazonaws.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://*.facebook.com https://*.twitter.com"
   },
   "description": "A homepage you will fall in love with! Notifications, badges, recent tabs, quick notes, calendar and more. AI search ChatGPT GPT-4o.",
   "host_permissions": [ "http://*/*", "https://*/*", "\u003Call_urls>" ],
   "icons": {
      "128": "icons/home.png",
      "16": "icons/home/home16.png",
      "32": "icons/home/home32.png",
      "48": "icons/home.png"
   },
   "manifest_version": 3,
   "name": "Home - New Tab Page | ChatGPT search with GPT-4o AI answers",
   "optional_permissions": [ "history" ],
   "permissions": [ "bookmarks", "tabs", "notifications", "webNavigation", "storage", "unlimitedStorage", "cookies", "idle", "alarms" ],
   "version": "24.12.10.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "css/search_badge.css" ]
   } ]
}
